# InfraSync Server Environment Variables

# ─── Supabase ───────────────────────────────────────────────────────────────
# Your Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe to use server-side for Row Level Security reads
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — NEVER expose to clients; server-only
# Used to bypass RLS for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Direct PostgreSQL Connection (optional fallback) ────────────────────────
# Use this if you prefer a direct pg connection (e.g., for transactions)
# Found in Supabase Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────────────────────
# Frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

